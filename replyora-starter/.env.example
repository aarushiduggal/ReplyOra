# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # SERVER ONLY — never expose client-side

# ---- AI ----
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...            # used for embeddings (text-embedding-3-small)

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PRICE_STARTER=price_...
NEXT_PUBLIC_STRIPE_PRICE_GROWTH=price_...
NEXT_PUBLIC_STRIPE_PRICE_PRO=price_...

# ---- Auth.js (Milestone 2 — Netlify/Neon logins) ----
# Session-signing secret. REQUIRED to turn on real logins. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=
# Tells the client login form to use Auth.js (set to 1 alongside AUTH_SECRET).
NEXT_PUBLIC_HAS_AUTHJS=1
# Google sign-in (optional). Leave blank to hide the Google button; fill in from
# a Google Cloud OAuth "Web application" client to enable it.
#   Authorized redirect URI: https://YOUR-SITE.netlify.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to 1 (alongside the two above) to show the "Continue with Google" button.
NEXT_PUBLIC_HAS_GOOGLE=

# ---- Social (Neon Postgres) ----
# Connection string for the ReplyOra Social store (Content Studio + Calendar).
# Get it from your Neon project dashboard → "Connection string". Looks like:
#   postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# LEAVE BLANK locally to use the free in-memory store (zero setup). Set it in
# Netlify's environment variables for the live site. Server-only — never commit.
DATABASE_URL=

# ---- App ----
# Your public site URL. Locally: http://localhost:3000. On Netlify: your live
# URL, e.g. https://replyora.netlify.app (set this in Netlify env once you have it).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Book a demo (optional) ----
# The agency's Calendly scheduling link (e.g. https://calendly.com/replyora/demo).
# Set it to show the inline Calendly widget on /demo. Leave blank to fall back to
# the "book by email" card.
NEXT_PUBLIC_CALENDLY_URL=

# ---- Analytics (optional) ----
# Set to your domain to enable Plausible (privacy-friendly, no cookie banner).
# Leave blank to disable — track() becomes a no-op.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ---- AI captions & chat (optional but recommended) ----
# One free key from https://aistudio.google.com/apikey powers all three AI
# paths: Studio caption writing, the /demo chat, and the client chatbox.
# Leave blank and everything still works on built-in templates / canned replies
# — the Studio now says on screen which one wrote your captions.
GEMINI_API_KEY=

# ---- Closed beta ----
# While DATABASE_URL is set, signup is INVITE-ONLY by default: both the signup
# form and "Continue with Google" refuse anyone without a valid invite. Existing
# accounts and STAFF_EMAILS/OWNER_EMAILS are never locked out.
# Set this to 1 to reopen public signup when the beta ends. Leaving it unset
# fails CLOSED, so a forgotten env var can't throw the doors open.
BETA_OPEN_SIGNUP=

# ---- Email (optional, recommended for the beta) ----
# A Resend API key lets Replyora email invite links to testers and alert you
# when someone joins the waitlist. Without it everything still works — you copy
# the invite link from the staff portal and send it yourself.
RESEND_API_KEY=
EMAIL_FROM=

# ---- Notion waitlist mirror (optional) ----
# Mirrors every new waitlist signup into a Notion database so you can triage
# there. Create an internal integration at notion.so/my-integrations, copy its
# secret, then open your database, click ••• → Connections → add the
# integration (without this the API can't see it). The database id is the
# 32-character string in the database URL.
# It adapts to whatever columns your database has — a title column is enough.
NOTION_TOKEN=
NOTION_WAITLIST_DB_ID=

